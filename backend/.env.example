# Copy to .env and fill in. docker compose reads it automatically.

# Auth0 API (Dashboard → Applications → APIs). Domain without https://, e.g. trailhub.eu.auth0.com
AUTH0_DOMAIN=
# The API "Identifier", e.g. https://api.trailhub.app
AUTH0_AUDIENCE=

# Auth0 (default) validates real tokens. "Development" accepts `Authorization: Dev <user-id>`
# so you can try the API without an Auth0 tenant. Only honored when ASPNETCORE_ENVIRONMENT=Development.
AUTH_MODE=Auth0
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_USER=trailhub
POSTGRES_PASSWORD=trailhub
RABBITMQ_USER=trailhub
RABBITMQ_PASSWORD=trailhub

# Photo storage (SeaweedFS locally). PHOTOS_PUBLIC_BASE_URL is what the app loads photos from:
# use your computer's LAN IP instead of localhost when testing on a physical phone.
PHOTOS_PUBLIC_BASE_URL=http://localhost:8080/photos

# Route planner. Mapbox does routing along paths, place search and huts/water/campsites: use the app's
# public token (pk.…, EXPO_PUBLIC_MAPBOX_TOKEN in mobile/.env.local). Without it, routes are straight lines.
MAPBOX_ACCESS_TOKEN=

# Optional: OpenRouteService's hiking profile instead of Mapbox (adds SAC trail grades). Free key:
# https://openrouteservice.org/dev/#/signup, then set ROUTING_PROVIDER=OpenRouteService.
ROUTING_PROVIDER=
OPENROUTESERVICE_API_KEY=

# Optional: your Auth0 user id (Profile → the "sub" claim, e.g. auth0|abc123) to review reported trails in the app.
MODERATOR_USER_ID=
