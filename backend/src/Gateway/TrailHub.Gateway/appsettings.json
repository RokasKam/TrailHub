{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://localhost:19006"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "profiles": {
        "ClusterId": "profile",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/profiles/{**rest}"
        }
      },
      "trails": {
        "ClusterId": "trails",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/trails/{**rest}"
        }
      },
      "activities": {
        "ClusterId": "activity",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/activities/{**rest}"
        }
      },
      "trips": {
        "ClusterId": "trips",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/trips/{**rest}"
        }
      },
      "groups": {
        "ClusterId": "groups",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/groups/{**rest}"
        }
      },
      "groups-hub": {
        "ClusterId": "groups",
        "Match": {
          "Path": "/hubs/groups/{**rest}"
        }
      },
      "weather": {
        "ClusterId": "weather",
        "RateLimiterPolicy": "per-client",
        "Match": {
          "Path": "/api/weather/{**rest}"
        }
      },
      "openapi-profile": {
        "ClusterId": "profile",
        "Match": {
          "Path": "/openapi/profile.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-trails": {
        "ClusterId": "trails",
        "Match": {
          "Path": "/openapi/trails.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-activity": {
        "ClusterId": "activity",
        "Match": {
          "Path": "/openapi/activity.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-trips": {
        "ClusterId": "trips",
        "Match": {
          "Path": "/openapi/trips.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-groups": {
        "ClusterId": "groups",
        "Match": {
          "Path": "/openapi/groups.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "openapi-weather": {
        "ClusterId": "weather",
        "Match": {
          "Path": "/openapi/weather.json"
        },
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "photos": {
        "ClusterId": "photos",
        "Match": {
          "Path": "/photos/{**key}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        },
        "Transforms": [
          {
            "PathPattern": "/trailhub-photos/{**key}"
          }
        ]
      }
    },
    "Clusters": {
      "profile": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "trails": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "activity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "trips": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "groups": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "weather": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "photos": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:58333"
          }
        }
      }
    }
  },
  "Swagger": {
    "Services": {
      "Profile": "profile",
      "Trails": "trails",
      "Activity": "activity",
      "Trips": "trips",
      "Groups": "groups",
      "Weather": "weather"
    }
  }
}
