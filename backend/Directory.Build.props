<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1848;CA1711;CA1716;CA1062;CA2007;CA1724;CA1031;CA1056;CA1054;CA1305;CA1307;CA1310;CA1309;CA1304;CA1311;CA1002;CA1819;CA1308;CA5394;CA1515;CA1034;CA1720;CA1707;CA1812;CA2227;CA1000;CA2225;CA1032;CA1822;CA1024;CA1508;CA1852;CA1873;CA1869;CA1859</NoWarn>
  </PropertyGroup>
  <!-- XML doc comments on controllers feed the Swagger descriptions. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Api'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
