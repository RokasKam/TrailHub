# Copy to .env.local. EXPO_PUBLIC_* values are bundled into the app (they're not secrets).

# Gateway URL. iOS simulator: http://localhost:8080 · Android emulator: http://10.0.2.2:8080
# Physical phone: your computer's LAN IP, e.g. http://192.168.0.173:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# "auth0" for real login, or "development" to sign in with any name (backend must run AUTH_MODE=Development).
EXPO_PUBLIC_AUTH_MODE=development

# Auth0 → Applications → (Native app). Audience = the API identifier the backend validates.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Mapbox public token (pk.…) from https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=
